{
	"name": "nginxwebui",
	"version": "0.0.1",
	"private": true,
	"prisma": {
		"seed": "tsx prisma/seed.ts"
	},
	"scripts": {
		"dev": "cross-env DEV_ENV=true vite dev",
		"build": "vite build",
		"prisma:inline": "cp ./node_modules/prisma/prisma-client/*.js ./node_modules/@prisma/client",
		"prisma:generate": "prisma generate && npm run prisma:inline",
		"preview": "vite preview",
		"debug:prod": "pnpm build && pnpm preview",
		"test": "npm run test:integration && npm run test:unit",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:integration": "playwright test",
		"test:unit": "vitest"
	},
	"devDependencies": {
		"@playwright/test": "^1.54.2",
		"@sveltejs/adapter-auto": "^3.3.1",
		"@sveltejs/adapter-node": "^5.3.1",
		"@sveltejs/kit": "^2.31.1",
		"@sveltejs/vite-plugin-svelte": "^5.1.1",
		"@types/eslint": "^8.56.12",
		"@types/node": "^20.19.11",
		"cross-env": "^7.0.3",
		"eslint": "^9.33.0",
		"eslint-config-prettier": "^9.1.2",
		"eslint-plugin-svelte": "^2.46.1",
		"globals": "^15.15.0",
		"prettier": "^3.6.2",
		"prettier-plugin-svelte": "^3.4.0",
		"svelte": "^5.38.1",
		"svelte-check": "^3.8.6",
		"ts-node": "^10.9.2",
		"tslib": "^2.8.1",
		"tsx": "^4.20.4",
		"typescript": "^5.9.2",
		"typescript-eslint": "^8.39.1",
		"vite": "^6.3.5",
		"vitest": "^1.6.1"
	},
	"type": "module",
	"dependencies": {
		"@prisma/client": "^6.14.0",
		"prisma": "^6.14.0"
	}
}
